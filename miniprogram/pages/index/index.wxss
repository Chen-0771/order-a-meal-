.page { min-height: 100vh; }
.hero { padding: 34rpx 30rpx 0; background: linear-gradient(180deg, #fff2e6 0%, #fff9f2 100%); }
.hero-top { display: flex; justify-content: space-between; align-items: center; }
.eyebrow { color: #b96c4a; font-size: 24rpx; letter-spacing: 4rpx; margin-bottom: 8rpx; }
.title { font-size: 48rpx; line-height: 1.2; font-weight: 800; letter-spacing: -1rpx; }
.member-pill { margin: 0; padding: 0 20rpx; min-width: 150rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; border-radius: 34rpx; background: rgba(255,255,255,.85); color: #554c44; font-size: 25rpx; box-shadow: 0 8rpx 28rpx rgba(96,54,31,.08); }
.chevron { color: #b8aca1; }
.hero-card { margin-top: 34rpx; padding: 30rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #ed7049, #d84928); box-shadow: 0 18rpx 38rpx rgba(202,69,35,.2); display: flex; align-items: center; justify-content: space-between; }
.hero-card-title { font-weight: 700; font-size: 32rpx; }
.hero-card-copy { margin-top: 7rpx; color: rgba(255,255,255,.8); font-size: 24rpx; }
.hero-card-action { padding: 14rpx 20rpx; border-radius: 28rpx; background: rgba(255,255,255,.18); font-size: 24rpx; }
.category-scroll { margin-top: 32rpx; width: 100%; white-space: nowrap; }
.category-row { display: inline-flex; gap: 16rpx; padding: 0 30rpx; }
.category { flex: none; padding: 15rpx 27rpx; border-radius: 28rpx; background: #fff; color: #746b63; border: 1rpx solid #f1e8df; font-size: 25rpx; }
.category.active { background: #2f2923; border-color: #2f2923; color: #fff; font-weight: 600; }
.section-head { margin: 40rpx 30rpx 20rpx; display: flex; justify-content: space-between; align-items: baseline; }
.section-title { font-size: 35rpx; font-weight: 800; }
.section-note { color: #aaa097; font-size: 24rpx; }
.dish-list { padding: 0 30rpx; }
.dish-card { position: relative; margin-bottom: 22rpx; padding: 22rpx; display: flex; align-items: center; gap: 14rpx; background: #fff; border-radius: 28rpx; box-shadow: 0 9rpx 30rpx rgba(76,54,38,.06); }
.dish-main { min-width: 0; flex: 1; display: flex; align-items: center; gap: 22rpx; }
.dish-art { width: 142rpx; height: 142rpx; flex: none; border-radius: 23rpx; display: flex; align-items: center; justify-content: center; font-size: 66rpx; }
.dish-info { min-width: 0; }
.dish-name { font-size: 31rpx; line-height: 1.2; font-weight: 700; }
.dish-subtitle { margin-top: 10rpx; color: #8d847c; font-size: 23rpx; }
.picked { margin-top: 12rpx; max-width: 260rpx; color: #cf512f; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picked.muted { color: #b0a79e; }
.order-button { margin: 0; padding: 0; width: 108rpx; height: 64rpx; line-height: 64rpx; flex: none; border-radius: 32rpx; background: #fff0e9; color: #d95331; font-weight: 700; font-size: 24rpx; }
.order-button.selected { background: #e65f38; color: #fff; }
.loading { padding: 120rpx 0; text-align: center; color: #9c938b; }
.mode-tip { margin: 34rpx 30rpx 10rpx; padding: 18rpx 24rpx; text-align: center; border-radius: 16rpx; background: #f7efe6; color: #a08f81; font-size: 21rpx; }
.sheet-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(38,31,26,.48); }
.member-sheet { width: 100%; padding: 18rpx 34rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 38rpx 38rpx 0 0; background: #fffdf9; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 30rpx; border-radius: 4rpx; background: #ded6ce; }
.sheet-title { font-size: 38rpx; font-weight: 800; }
.sheet-copy { margin-top: 9rpx; color: #91877e; font-size: 24rpx; }
.member-grid { margin-top: 30rpx; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.member-card { margin: 0; padding: 18rpx 4rpx; background: #fff; color: #49413a; font-size: 25rpx; border-radius: 22rpx; border: 1rpx solid #eee5dc; }
.member-avatar { width: 78rpx; height: 78rpx; margin: 0 auto 12rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
