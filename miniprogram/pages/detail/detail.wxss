.page { min-height: 100vh; padding-bottom: 150rpx; box-sizing: border-box; }
.cover { position: relative; height: 420rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.cover-glow { position: absolute; width: 330rpx; height: 330rpx; border-radius: 50%; background: rgba(255,255,255,.35); filter: blur(2rpx); }
.cover-emoji { position: relative; font-size: 154rpx; filter: drop-shadow(0 20rpx 18rpx rgba(80,50,25,.16)); }
.category-tag { position: absolute; top: 28rpx; right: 30rpx; padding: 10rpx 20rpx; border-radius: 24rpx; background: rgba(255,255,255,.7); color: #65584d; font-size: 22rpx; }
.content-card { position: relative; margin-top: -34rpx; padding: 38rpx 34rpx 60rpx; border-radius: 38rpx 38rpx 0 0; background: #fff9f2; }
.dish-title { font-size: 48rpx; font-weight: 800; }
.dish-meta { margin-top: 9rpx; color: #bd6548; font-size: 25rpx; }
.description { margin-top: 25rpx; color: #746b63; font-size: 27rpx; line-height: 1.75; }
.picked-panel { margin-top: 30rpx; padding: 22rpx 24rpx; display: flex; align-items: center; gap: 18rpx; border-radius: 22rpx; background: #fff0e8; }
.picked-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #e65f38; }
.picked-title { font-weight: 700; font-size: 26rpx; }
.picked-names { margin-top: 5rpx; color: #a46f5d; font-size: 22rpx; }
.section-title { margin-top: 48rpx; display: flex; justify-content: space-between; align-items: center; font-size: 34rpx; font-weight: 800; }
.ingredient-count { color: #a39a91; font-size: 22rpx; font-weight: 400; }
.ingredient-list { margin-top: 18rpx; overflow: hidden; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(70,50,35,.05); }
.ingredient { min-height: 88rpx; padding: 0 24rpx; display: flex; align-items: center; border-bottom: 1rpx solid #f2ebe4; }
.ingredient:last-child { border-bottom: none; }
.ingredient-dot { width: 12rpx; height: 12rpx; margin-right: 18rpx; border-radius: 50%; background: #e65f38; }
.ingredient-name { flex: 1; color: #49423c; }
.ingredient-amount { color: #8c8279; }
.bottom-action { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 22rpx; background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 30rpx rgba(60,40,27,.08); }
.identity { width: 168rpx; color: #776d64; font-size: 23rpx; display: flex; gap: 8rpx; align-items: center; }
.primary-button { flex: 1; margin: 0; border-radius: 44rpx; background: #e65f38; color: #fff; font-size: 28rpx; font-weight: 700; }
.primary-button.selected { background: #37302a; }
