.page { min-height: 100vh; padding: 28rpx 30rpx; box-sizing: border-box; }
.summary-card { padding: 34rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(145deg, #3e3730, #28231f); box-shadow: 0 18rpx 38rpx rgba(50,38,29,.2); }
.summary-eyebrow { color: #dbcfc5; font-size: 23rpx; letter-spacing: 3rpx; }
.summary-row { margin-top: 14rpx; display: flex; align-items: baseline; justify-content: space-between; }
.summary-number { font-size: 72rpx; line-height: 1; font-weight: 800; }
.summary-unit { font-size: 27rpx; }
.summary-people { color: #f4b99e; font-size: 24rpx; }
.summary-line { height: 1rpx; margin: 28rpx 0 20rpx; background: rgba(255,255,255,.14); }
.summary-tip { color: #c8bdb4; font-size: 22rpx; }
.section-head { margin: 42rpx 2rpx 20rpx; display: flex; justify-content: space-between; align-items: baseline; }
.section-title { font-size: 35rpx; font-weight: 800; }
.section-note { color: #a49a91; font-size: 21rpx; }
.order-card { margin-bottom: 20rpx; padding: 22rpx; display: flex; align-items: center; background: #fff; border-radius: 26rpx; box-shadow: 0 8rpx 28rpx rgba(74,51,35,.055); }
.dish-art { width: 116rpx; height: 116rpx; flex: none; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 54rpx; }
.order-info { min-width: 0; flex: 1; margin-left: 22rpx; }
.order-name { font-size: 30rpx; font-weight: 700; }
.order-by { margin-top: 9rpx; color: #837970; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-count { margin-top: 8rpx; color: #d55532; font-size: 21rpx; }
.cancel-button { margin: 0; padding: 0; width: 88rpx; height: 56rpx; line-height: 56rpx; border-radius: 28rpx; background: #f6f0ea; color: #8d8176; font-size: 22rpx; }
.arrow { padding: 20rpx 8rpx 20rpx 20rpx; color: #c6bbb1; font-size: 44rpx; }
.browse-button { margin-top: 42rpx; width: 260rpx; border-radius: 48rpx; background: #e65f38; color: #fff; font-size: 28rpx; }
.loading { padding-top: 180rpx; text-align: center; color: #9d9389; }
